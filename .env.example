# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# JWT — use a long random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Internal service URLs (used by docker-compose networking — do not change)
REDIS_URL=redis://redis:6379
MONGO_URL=mongodb://mongodb:27017/taskdb
SERVICE_URL=http://service:3001

# Frontend URL (used for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Gateway public URL (used to build OAuth callback URL)
API_GATEWAY_URL=http://localhost:8080

# Google OAuth (optional — leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/oauth/google/callback
