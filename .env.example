# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# JWT — use a long random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Internal service URLs (used by docker-compose networking — do not change)
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# JWT — use a long random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Internal service URLs (docker-compose networking — do not change)
REDIS_URL=redis://redis:6379
MONGO_URL=mongodb://mongodb:27017/taskdb
SERVICE_URL=http://service:3001

# FRONTEND_URL: what the BROWSER uses to reach the frontend (not internal docker hostname)
# In local dev this is http://localhost:3000
# In production: https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Gateway public URL — used to build the OAuth callback URL that Google redirects to
# Must be the URL the browser can reach (port 8080 in local dev)
API_GATEWAY_URL=http://localhost:8080

# ============================================================
# Email (Nodemailer) — for forgot password / forgot username
#
# Gmail setup (recommended for testing):
#   1. Enable 2-Factor Authentication on your Google account
#   2. Go to: Google Account → Security → App Passwords
#   3. Generate a new App Password (select "Mail")
#   4. Use that 16-char password as SMTP_PASS (no spaces)
#
# Other providers: Outlook (smtp.office365.com:587),
#   SendGrid (smtp.sendgrid.net:587, user=apikey, pass=<api-key>)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=Tasken <your.email@gmail.com>

# Setup: https://console.cloud.google.com/ → Credentials → OAuth client ID
# Authorised redirect URI: http://localhost:8080/api/auth/oauth/google/callback
#
# See docs/google-oauth-setup.md for the full step-by-step guide and
# an explanation of the redirect fix.
# ============================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxx
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/oauth/google/callback
